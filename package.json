{
  "name": "TabsBookVsCode",
  "displayName": "Tabs Book",
  "publisher": "oliwkan091",
  "id": "my-first-extension",
  "description": "Tabs Book allows you to take a 'snapshot' of your currently open document tabs-preserving their exact order and pinned status-and restore them instantly at a later time. Whether you are switching between feature branches, investigating a bug, or reviewing code, you can now save your workspace context with a custom name and return to it in seconds.",
  "icon": "resources/icon90.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/oliwkan091/TabsBookVsCode"
  },
  "version": "1.0.3",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "Document Manager", 
    "Organization", 
    "Productivity", 
    "Session", 
    "Tab Manager", 
    "Tabs", 
    "Tabs Saver", 
    "Workflow"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
     "commands": [
      {
        "command": "extension.saveTabsAs",
        "title": "Save Open Tabs As..."
      },
      {
        "command": "extension.restoreTabs",
        "title": "Restore Saved Tabs..."
      },
      {
        "command": "extension.deleteTabs",
        "title": "Delete Saved Tab Sets..."
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.99.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2"
  }
}
